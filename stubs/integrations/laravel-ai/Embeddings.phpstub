<?php

namespace Laravel\Ai;

use Laravel\Ai\Files\Audio;
use Laravel\Ai\Files\Document;
use Laravel\Ai\Files\Image;
use Laravel\Ai\Files\Video;
use Laravel\Ai\PendingResponses\PendingEmbeddingsGeneration;

/**
 * Only the test-double surface is waived; every other member must stay restated so a new sink fails CI
 * (policy: "Stub merging" in docs/contributing/README.md). `fakeEmbedding()` stays because its
 * `@return array<float>` is a type enhancement the reflected signature lacks.
 *
 * @stub-waive assert*()  test-double assertions; recorded calls, never model-facing text
 * @stub-waive fake()     test double; swaps the gateway, carries no prompt text
 * @stub-waive isFaked()  no parameters; a boolean over whether the gateway is swapped
 */
class Embeddings
{
    /**
     * This method also serves ordinary query embedding for vector search; it
     * does not invoke a generative model and is intentionally not an
     * `llm_prompt` sink.
     *
     * The union is copied from vendor/laravel/ai/src/Embeddings.php. Narrowing
     * it to `string[]` here made a valid `Document::fromString()` argument a
     * false `InvalidArgument`, and native types match on both sides (`array`),
     * so bin/ci/check-laravel-ai-stub-parity.php cannot see docblock drift of
     * this shape.
     *
     * @param  array<int, string|Audio|Document|Image|Video>  $inputs
     *
     */
    public static function for(array $inputs): PendingEmbeddingsGeneration {}

    /** @return array<float> */
    public static function fakeEmbedding(int $dimensions): array {}
}
