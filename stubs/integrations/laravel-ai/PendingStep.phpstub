<?php

namespace Laravel\Ai;

use Laravel\Ai\Gateway\TextGenerationOptions;
use Laravel\Ai\Responses\Data\TextUsage;

/**
 * Agent middleware mutates this value immediately before a generation step.
 * The text-bearing overrides below reach the provider from
 * `vendor/laravel/ai/src/PendingStep.php` and are prompt-injection boundaries.
 *
 * @stub-waive isFirstStep() no parameters; a boolean over the step number
 * @stub-waive onlyTools() names select among tools already on the step and add no text; the tool list itself is sunk by `withTools()`
 * @stub-waive withoutTools() names remove tools already on the step and add no text
 * @stub-waive withMaxTokens() an int cap; carries no text to the model
 */
class PendingStep
{
    public function __construct(
        public readonly int $number,
        public readonly bool $isFinalStep,
        public readonly string $provider,
        public readonly string $model,
        public readonly ?string $instructions,
        public readonly array $messages,
        public readonly array $tools,
        public readonly ?array $schema,
        public readonly ?TextGenerationOptions $options,
        public readonly array $steps = [],
        public readonly TextUsage $usage = new TextUsage,
        public readonly ?int $timeout = null,
        public readonly ?string $invocationId = null,
    ) {}

    public function withModel(string $model): self {}

    /**
     * @psalm-taint-sink llm_prompt $instructions
     */
    public function withInstructions(?string $instructions): self {}

    /**
     * @psalm-taint-sink llm_prompt $messages
     */
    public function withMessages(iterable $messages): self {}

    /**
     * @psalm-taint-sink llm_prompt $tools
     */
    public function withTools(iterable $tools): self {}

    public function withToolChoice(ToolChoice|string|array|null $toolChoice): self {}

    /**
     * @psalm-taint-sink llm_prompt $providerOptions
     */
    public function withProviderOptions(array $providerOptions): self {}

    protected function withOptions(TextGenerationOptions $options): self {}

    protected function resolvedOptions(): TextGenerationOptions {}

    protected function with(array $overrides): self {}
}
