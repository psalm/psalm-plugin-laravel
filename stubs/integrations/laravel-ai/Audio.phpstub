<?php

namespace Laravel\Ai;

use Laravel\Ai\PendingResponses\PendingAudioGeneration;

/**
 * Only the test-double surface is waived; every other member must stay restated so a new sink fails CI
 * (policy: "Stub merging" in docs/contributing/README.md).
 *
 * @stub-waive assert*()  test-double assertions; recorded calls, never model-facing text
 * @stub-waive fake()     test double; swaps the gateway, carries no prompt text
 * @stub-waive isFaked()  no parameters; a boolean over whether the gateway is swapped
 */
class Audio
{
    /**
     * TTS input. The text is read by the model that does the synthesis;
     * adversarial inputs can steer voice, language, or emit unintended speech.
     *
     * @psalm-taint-sink llm_prompt $text
     */
    public static function of(string $text): PendingAudioGeneration {}
}
