<?php

namespace Laravel\Ai\PendingResponses;

use BackedEnum;
use Illuminate\Support\Traits\Conditionable;
use Laravel\Ai\Enums\Lab;
use Laravel\Ai\PendingResponses\Concerns\ResolvesProviderOptions;
use Laravel\Ai\Responses\AudioResponse;
use Laravel\Ai\Responses\QueuedAudioResponse;

/**
 * Pending text-to-speech request. The free-form `instructions()` string is a
 * style prompt handed to the speech model, the same boundary as the sinked
 * text passed to `Audio::of()`; the rest of the public surface is retained
 * unchanged.
 *
 * @stub-waive male() no parameters; selects a built-in voice id
 * @stub-waive female() no parameters; selects a built-in voice id
 * @stub-waive timeout() an int number of seconds; carries no text to the model
 */
class PendingAudioGeneration
{
    use Conditionable;
    use ResolvesProviderOptions;

    protected string $voice = 'default-female';

    protected ?string $instructions = null;

    protected int $timeout = 30;

    public function __construct(
        protected string $text,
    ) {}

    public function voice(BackedEnum|string $voice): self {}

    /**
     * @psalm-taint-sink llm_prompt $instructions
     */
    public function instructions(string $instructions): self {}

    public function generate(Lab|array|string|null $provider = null, ?string $model = null): AudioResponse {}

    public function queue(Lab|array|string|null $provider = null, ?string $model = null): QueuedAudioResponse {}
}
