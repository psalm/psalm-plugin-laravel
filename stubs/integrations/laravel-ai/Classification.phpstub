<?php

namespace Laravel\Ai;

use Laravel\Ai\PendingResponses\PendingClassification;

/**
 * `AiServiceProvider::boot()` registers several macros that forward their
 * input to a model, and none is declared as an `llm_prompt` sink here or
 * anywhere else: `Str::summarize()` and `Stringable::summarize()` (prompt a
 * `SummarizeAgent`), `Stringable::toAudio()` (calls `Audio::of()`),
 * `Str::decide()`, `Stringable::decide()`, and `Collection::decide()` (calls
 * `CollectionChoice::decide()`), and `Collection::rerank()` (calls
 * `PendingReranking::rerank()`). Macroable exposes only pseudo-methods with no
 * per-method docblock on which to declare a sink. Closing that coverage gap
 * requires a call-analysis handler for the macro forms, or Psalm support for
 * taint annotations on registered macro signatures.
 *
 * Only the test-double surface is waived; every other member must stay restated so a new sink fails CI
 * (policy: "Stub merging" in docs/contributing/README.md).
 *
 * @stub-waive assert*()  test-double assertions; recorded calls, never model-facing text
 * @stub-waive fake()     test double; swaps the gateway, carries no prompt text
 * @stub-waive isFaked()  no parameters; a boolean over whether the gateway is swapped
 */
class Classification
{
    /**
     * `PendingClassification::classify()` sends this state to the model; see
     * `vendor/laravel/ai/src/Classification.php`.
     *
     * @psalm-taint-sink llm_prompt $state
     */
    public static function of(string|array $state): PendingClassification {}
}
