<?php

namespace Laravel\Ai;

use Illuminate\Broadcasting\Channel;
use Illuminate\Queue\SerializesModels;
use Closure;
use Laravel\Ai\Approvals\Decisions;
use Laravel\Ai\Contracts\AgentInput;
use Laravel\Ai\Contracts\Providers\TextProvider;
use Laravel\Ai\Enums\Lab;
use Laravel\Ai\Messages\Message;
use Laravel\Ai\Messages\UserMessage;
use Laravel\Ai\Responses\AgentResponse;
use Laravel\Ai\Responses\QueuedAgentResponse;
use Laravel\Ai\Responses\StreamableAgentResponse;
use Laravel\SerializableClosure\SerializableClosure;

/**
 * Trait used by every user-defined agent class.
 *
 * Prompt-family methods below route their prompt input into the LLM provider,
 * so each is a sink for the `llm_prompt` taint kind. Taint propagating from
 * `Request::input()`, `Http::*->body()`, `Storage::get()`, or any other source
 * the plugin marks as `@psalm-taint-source input` ends here.
 *
 * `use SerializesModels` and the `make()` factory are restated verbatim from
 * `vendor/laravel/ai/src/Promptable.php` because re-declaring this trait to
 * add taint annotations would otherwise erase them from every user agent
 * class (see "Stub merging" in `docs/contributing/README.md`). The remaining
 * private provider/failover internals (`withModelFailover`,
 * `iterateProvidersWithFailover`, …) are intentionally left to reflected
 * source — they take no taint annotations, and inflating the stub would only
 * add maintenance drift.
 *
 * The test-double surface is the one waived family; every other member must stay restated so a new sink or
 * source fails CI (policy: "Stub merging" in `docs/contributing/README.md`).
 *
 * @stub-waive assert*()  test-double assertions; recorded calls, never model-facing text
 * @stub-waive fake()     test double; swaps the gateway, carries no prompt text
 * @stub-waive isFaked()  no parameters; a boolean over whether the gateway is swapped
 *
 * @see https://genai.owasp.org/llmrisk/llm01-prompt-injection/ OWASP LLM01:2025
 */
trait Promptable
{
    use SerializesModels;

    /**
     * The ad-hoc message history to send ahead of the next prompt.
     *
     * @var list<Message>|null
     */
    protected ?array $adHocMessages = null;

    /**
     * The runtime tool override, replacing the tools the agent declares.
     */
    protected ?SerializableClosure $runtimeTools = null;

    public static function make(...$arguments): static {}

    /**
     * @psalm-taint-sink llm_prompt $prompt
     */
    public function prompt(
        AgentInput|UserMessage|Decisions|string $prompt,
        array $attachments = [],
        Lab|array|string|null $provider = null,
        ?string $model = null,
        ?int $timeout = null,
    ): AgentResponse {}

    /**
     * @psalm-taint-sink llm_prompt $prompt
     */
    public function stream(
        AgentInput|UserMessage|Decisions|string $prompt,
        array $attachments = [],
        Lab|array|string|null $provider = null,
        ?string $model = null,
        ?int $timeout = null,
    ): StreamableAgentResponse {}

    /**
     * @psalm-taint-sink llm_prompt $prompt
     */
    public function queue(
        AgentInput|UserMessage|Decisions|string $prompt,
        array $attachments = [],
        Lab|array|string|null $provider = null,
        ?string $model = null,
    ): QueuedAgentResponse {}

    /**
     * @psalm-taint-sink llm_prompt $prompt
     */
    public function broadcast(
        AgentInput|UserMessage|Decisions|string $prompt,
        Channel|array $channels,
        array $attachments = [],
        bool $now = false,
        Lab|array|string|null $provider = null,
        ?string $model = null,
    ): StreamableAgentResponse {}

    /**
     * @psalm-taint-sink llm_prompt $prompt
     */
    public function broadcastNow(
        AgentInput|UserMessage|Decisions|string $prompt,
        Channel|array $channels,
        array $attachments = [],
        Lab|array|string|null $provider = null,
        ?string $model = null,
    ): StreamableAgentResponse {}

    /**
     * @psalm-taint-sink llm_prompt $prompt
     */
    public function broadcastOnQueue(
        AgentInput|UserMessage|Decisions|string $prompt,
        Channel|array $channels,
        array $attachments = [],
        Lab|array|string|null $provider = null,
        ?string $model = null,
    ): QueuedAgentResponse {}

    /**
     * @psalm-taint-sink llm_prompt $messages
     */
    public function withMessages(iterable $messages): static {}

    /**
     * No sink: `$tools` transports Tool instances; model-visible descriptions are return values Psalm cannot target.
     */
    public function withTools(Closure|iterable $tools): static {}

    protected function resolveAgentTools(): ?array {}

    protected function getProvidersAndModels(Lab|array|string|null $provider, ?string $model): array {}

    protected function getDefaultModelFor(TextProvider $provider): string {}

    protected function getTimeout(?int $timeout): int {}
}
