<?php

namespace Carbon;

use DateTimeImmutable;

/**
 * Getter returns `(int)` (Traits/Date.php:1162-1164); CarbonImmutable.php:45 documents the setter input for both.
 *
 * @property-read int $timestamp
 * @property-write int|float|string $timestamp
 */
class CarbonImmutable extends DateTimeImmutable implements CarbonInterface {}
