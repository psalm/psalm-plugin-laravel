<?php

namespace Illuminate\Session;

class Store implements \Illuminate\Contracts\Session\Session
{
    /**
     * Get an item from the session.
     *
     * @param  \UnitEnum|string  $key
     * @param  mixed  $default
     * @return mixed
     *
     * @psalm-flow \Illuminate\Contracts\Session\Session::$attributes[$key] -> return
     * @psalm-flow ($default) -> return
     */
    public function get($key, $default = null) {}

    /**
     * Get the value of a given key and then forget it.
     *
     * @param  \UnitEnum|string  $key
     * @param  mixed  $default
     * @return mixed
     *
     * @psalm-flow \Illuminate\Contracts\Session\Session::$attributes[$key] -> return
     * @psalm-flow ($default) -> return
     */
    public function pull($key, $default = null) {}

    /**
     * Get all of the session data.
     *
     * @return array
     *
     * @psalm-flow \Illuminate\Contracts\Session\Session::$attributes[*] -> return
     */
    public function all() {}

    /**
     * Get a subset of the session data.
     *
     * @param  array  $keys
     * @return array
     *
     * @psalm-flow \Illuminate\Contracts\Session\Session::$attributes[$keys[*]] -> return
     */
    public function only(array $keys) {}

    /**
     * Get all the session data except for a specified array of items.
     *
     * @param  array  $keys
     * @return array
     *
     * @psalm-flow \Illuminate\Contracts\Session\Session::$attributes[*] -> return
     */
    public function except(array $keys) {}

    /**
     * Remove an item from the session, returning its value.
     *
     * @param  \UnitEnum|string  $key
     * @return mixed
     *
     * @psalm-flow \Illuminate\Contracts\Session\Session::$attributes[$key] -> return
     */
    public function remove($key) {}

    /**
     * Get the requested item from the flashed input array.
     *
     * @param  string|null  $key
     * @param  mixed  $default
     * @return ($key is null ? array<string, mixed> : mixed)
     *
     * @psalm-taint-source input
     */
    public function getOldInput($key = null, $default = null) {}

    /**
     * Get an item from the session, or store the default value.
     *
     * @param  \UnitEnum|string  $key
     * @param  \Closure  $callback
     * @return mixed
     *
     * @psalm-flow \Illuminate\Contracts\Session\Session::$attributes[$key] -> return
     * @psalm-flow ($callback()) -> return
     * @psalm-flow ($callback()) -> \Illuminate\Contracts\Session\Session::$attributes[$key]
     */
    public function remember($key, \Closure $callback) {}

    /**
     * Get the previous URL from the session.
     *
     * @return string|null
     *
     * @psalm-taint-source input
     */
    public function previousUrl() {}

    /**
     * Checks if a key exists in the session.
     *
     * Accepts an array of keys or variadic key arguments via func_get_args().
     *
     * @param  \UnitEnum|string|array  $key
     * @return bool
     *
     * @psalm-variadic
     */
    public function exists($key) {}

    /**
     * Determine if any of the given keys are present and not null in the session.
     *
     * Accepts an array of keys or variadic key arguments via func_get_args().
     *
     * @param  \UnitEnum|string|array  $key
     * @return bool
     *
     * @psalm-variadic
     */
    public function has($key) {}

    /**
     * Determine if any of the given keys are present and not null.
     *
     * Accepts an array of keys or variadic key arguments via func_get_args().
     *
     * @param  \UnitEnum|string|array  $key
     * @return bool
     *
     * @psalm-variadic
     */
    public function hasAny($key) {}

    /**
     * Reflash a subset of the current flash data.
     *
     * Accepts an array of keys, null (reflash all), or variadic key arguments via func_get_args().
     *
     * @param  string|array|null  $keys
     * @return void
     *
     * @psalm-variadic
     */
    public function keep($keys = null) {}

    /**
     * Put a key / value pair or array of key / value pairs in the session.
     *
     * @param  \UnitEnum|string|array  $key
     * @param  mixed  $value
     * @return void
     *
     * @psalm-flow ($value) -> \Illuminate\Contracts\Session\Session::$attributes[$key]
     * @psalm-flow ($key) -> \Illuminate\Contracts\Session\Session::$attributes[*]
     */
    public function put($key, $value = null) {}

    /**
     * Push a value onto a session array.
     *
     * @param  \UnitEnum|string  $key
     * @param  mixed  $value
     * @return void
     *
     * @psalm-flow ($value) -> \Illuminate\Contracts\Session\Session::$attributes[$key]
     */
    public function push($key, $value) {}

    /**
     * Flash a key / value pair to the session.
     *
     * @param  \UnitEnum|string  $key
     * @param  mixed  $value
     * @return void
     *
     * @psalm-flow ($value) -> \Illuminate\Contracts\Session\Session::$attributes[$key]
     */
    public function flash(\BackedEnum|\UnitEnum|string $key, $value = true) {}

    /**
     * Flash a key / value pair to the session for immediate use.
     *
     * @param  \UnitEnum|string  $key
     * @param  mixed  $value
     * @return void
     *
     * @psalm-flow ($value) -> \Illuminate\Contracts\Session\Session::$attributes[$key]
     */
    public function now($key, $value) {}
}
