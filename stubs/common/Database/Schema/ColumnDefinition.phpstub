<?php

namespace Illuminate\Database\Schema;

use Illuminate\Support\Fluent;

/**
 * Only lock() is stubbed; every other fluent method resolves from the class-level @method tags
 * in Laravel's source (kept when Psalm merges this declaration into the reflected class).
 *
 * Laravel documents lock() with the same four-literal union, but Psalm does not enforce an
 * @method param union of 4+ literals (3 are enforced): https://github.com/vimeo/psalm/issues/TBD
 * A real method is checked, so lock() is declared here until that is fixed upstream.
 */
class ColumnDefinition extends Fluent
{
    /**
     * Specify the DDL lock mode for the column operation (MySQL).
     *
     * @param 'none'|'shared'|'default'|'exclusive' $value
     */
    public function lock(string $value): static {}
}
