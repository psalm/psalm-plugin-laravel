<?php

namespace Illuminate\Database\Eloquent;

use Illuminate\Contracts\Queue\QueueableCollection;
use Illuminate\Support\Collection as BaseCollection;

/**
 * @template TKey of array-key
 * @template TModel of \Illuminate\Database\Eloquent\Model
 * @extends \Illuminate\Support\Collection<TKey, TModel>
 *
 * Psalm does not inherit @property-read from a parent class when template parameters
 * are remapped via @extends, so these annotations must be repeated here with TModel.
 *
 * The list mirrors EnumeratesValues::$proxies at the lowest supported 12.x — do not edit without checking that array.
 * `$sole` is left out on purpose: Laravel added it in 13.33.0 and declares it in its own docblock there.
 * Note: $hasMany here is a collection method (not an Eloquent relationship).
 * The third proxy argument spells the receiver class out instead of Laravel's `static`: a stub
 * `@property-read` keeps `static` unparameterized (`Collection&static`), losing TKey/TModel.
 *
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'average', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $average
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'avg', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $avg
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'contains', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $contains
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'doesntContain', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $doesntContain
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'each', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $each
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'every', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $every
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'filter', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $filter
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'first', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $first
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'flatMap', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $flatMap
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'groupBy', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $groupBy
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'hasMany', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $hasMany
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'hasSole', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $hasSole
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'keyBy', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $keyBy
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'last', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $last
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'map', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $map
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'max', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $max
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'min', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $min
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'partition', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $partition
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'percentage', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $percentage
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'reject', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $reject
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'skipUntil', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $skipUntil
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'skipWhile', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $skipWhile
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'some', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $some
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'sortBy', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $sortBy
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'sortByDesc', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $sortByDesc
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'sum', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $sum
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'takeUntil', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $takeUntil
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'takeWhile', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $takeWhile
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'unique', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $unique
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'unless', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $unless
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'until', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $until
 * @property-read \Illuminate\Support\HigherOrderCollectionProxy<'when', TModel, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> $when
 */
class Collection extends BaseCollection implements QueueableCollection
{
    /**
     * Find a model in the collection by key.
     *
     * @template TFindKey
     * @template TFindDefault
     *
     * @param  TFindKey  $key
     * @param  TFindDefault  $default
     * @psalm-return (TFindKey is \Illuminate\Database\Eloquent\Model ? TModel|TFindDefault : (TFindKey is (\Illuminate\Contracts\Support\Arrayable<array-key, mixed>|array<mixed>) ? static<TKey, TModel> : TModel|TFindDefault))
     */
    public function find($key, $default = null) {}

    /**
     * Run a map over each of the items.
     *
     * Laravel returns static (Eloquent\Collection) only when every mapped value is a Model, and
     * falls back to Support\Collection (via toBase()) otherwise. A conditional return cannot say
     * that: Psalm keeps the non-taken `static<TKey, TMapValue>` branch for a scalar TMapValue and
     * bound-checks it against `TModel of Model` (InvalidTemplateParam). The stub therefore declares
     * the always-true Support\Collection supertype; EloquentCollectionMapHandler narrows it back
     * to Eloquent\Collection when the callback provably returns models.
     *
     * @template TMapValue
     *
     * @param  callable(TModel, TKey): TMapValue  $callback
     * @return \Illuminate\Support\Collection<TKey, TMapValue>
     */
    public function map(callable $callback) {}

    /**
     * Run an associative map over each of the items.
     *
     * Declared as the Support\Collection supertype for the same reason as map().
     *
     * @template TMapWithKeysKey of array-key
     * @template TMapWithKeysValue
     *
     * @param  callable(TModel, TKey): array<TMapWithKeysKey, TMapWithKeysValue>  $callback
     * @return \Illuminate\Support\Collection<TMapWithKeysKey, TMapWithKeysValue>
     */
    public function mapWithKeys(callable $callback) {}

    /**
     * Load a set of relationships onto the collection.
     *
     * @param  array<array-key, array|(callable(\Illuminate\Database\Eloquent\Relations\Relation): mixed)|string>|string  $relations
     * @return $this
     *
     * @psalm-variadic
     */
    public function load($relations) {}

    /**
     * Load a set of relationships onto the collection if they are not already eager loaded.
     *
     * @param  array<array-key, array|(callable(\Illuminate\Database\Eloquent\Relations\Relation): mixed)|string>|string  $relations
     * @return $this
     *
     * @psalm-variadic
     */
    public function loadMissing($relations) {}

    /*
     * The overrides below re-declare Support\Collection methods whose `static<K, V>` return can hold
     * values that are not models, which fails the `TModel of Model` bound of this class
     * (InvalidTemplateParam, #1699). The outer collection widens to Support\Collection, a supertype
     * of the runtime Eloquent\Collection. Inner collections of models name the Eloquent class
     * explicitly: a `static` nested inside another class's generic is re-bound to the OUTER
     * collection on later calls (`->first()`, `->get()`), which brings the bound error back.
     *
     * Userland subclasses do not inherit these overrides on their own (see
     * EloquentCollectionSubclassInheritanceRepair).
     */

    /**
     * Chunk the collection into chunks of the given size.
     *
     * @param  int  $size
     * @param  bool  $preserveKeys
     * @return ($preserveKeys is true ? \Illuminate\Support\Collection<int, \Illuminate\Database\Eloquent\Collection<TKey, TModel>> : \Illuminate\Support\Collection<int, \Illuminate\Database\Eloquent\Collection<int, TModel>>)
     */
    public function chunk($size, $preserveKeys = true) {}

    /**
     * Chunk the collection into chunks with a callback.
     *
     * The callback receives the chunk being built, which Laravel's LazyCollection creates as a plain
     * Support\Collection, not as this class.
     *
     * @param  callable(TModel, TKey, \Illuminate\Support\Collection<TKey, TModel>): bool  $callback
     * @return \Illuminate\Support\Collection<int, \Illuminate\Database\Eloquent\Collection<TKey, TModel>>
     */
    public function chunkWhile(callable $callback) {}

    /**
     * Split a collection into a certain number of groups.
     *
     * @param  int  $numberOfGroups
     * @return \Illuminate\Support\Collection<int, \Illuminate\Database\Eloquent\Collection<TKey, TModel>>
     */
    public function split($numberOfGroups) {}

    /**
     * Split a collection into a certain number of groups, and fill the first groups completely.
     *
     * @param  int  $numberOfGroups
     * @return \Illuminate\Support\Collection<int, \Illuminate\Database\Eloquent\Collection<TKey, TModel>>
     */
    public function splitIn($numberOfGroups) {}

    /**
     * Create chunks representing a "sliding window" view of the items in the collection.
     *
     * @param  int  $size
     * @param  int  $step
     * @return \Illuminate\Support\Collection<int, \Illuminate\Database\Eloquent\Collection<TKey, TModel>>
     */
    public function sliding($size = 2, $step = 1) {}

    /**
     * Group an associative array by a field or using a callback.
     *
     * @template TGroupKey of array-key|\UnitEnum|\Stringable
     *
     * @param  (callable(TModel, TKey): TGroupKey)|array|string  $groupBy
     * @param  bool  $preserveKeys
     * @return \Illuminate\Support\Collection<
     *  ($groupBy is (array|string)
     *      ? array-key
     *      : (TGroupKey is \UnitEnum ? array-key : (TGroupKey is \Stringable ? string : TGroupKey))),
     *  ($groupBy is array ? \Illuminate\Support\Collection<array-key, mixed> : \Illuminate\Database\Eloquent\Collection<($preserveKeys is true ? TKey : int), TModel>)
     * >
     */
    public function groupBy($groupBy, $preserveKeys = false) {}

    /**
     * Partition the collection into two collections using the given callback or key.
     *
     * Laravel's own override documents the partitions as `static<TKey, TModel>`; see the note above
     * on why the Eloquent class is named instead.
     *
     * @param  (callable(TModel, TKey): bool)|TModel|string  $key
     * @param  mixed  $operator
     * @param  mixed  $value
     * @return \Illuminate\Support\Collection<int<0, 1>, \Illuminate\Database\Eloquent\Collection<TKey, TModel>>
     */
    public function partition($key, $operator = null, $value = null) {}

    /**
     * Run a grouping map over the items.
     *
     * @template TMapToGroupsKey of array-key
     * @template TMapToGroupsValue
     *
     * @param  callable(TModel, TKey): array<TMapToGroupsKey, TMapToGroupsValue>  $callback
     * @return \Illuminate\Support\Collection<TMapToGroupsKey, \Illuminate\Support\Collection<int, TMapToGroupsValue>>
     */
    public function mapToGroups(callable $callback) {}

    /**
     * Run a dictionary map over the items.
     *
     * @template TMapToDictionaryKey of array-key
     * @template TMapToDictionaryValue
     *
     * @param  callable(TModel, TKey): array<TMapToDictionaryKey, TMapToDictionaryValue>  $callback
     * @return \Illuminate\Support\Collection<TMapToDictionaryKey, array<int, TMapToDictionaryValue>>
     */
    public function mapToDictionary(callable $callback) {}

    /**
     * Run a map over each nested chunk of items.
     *
     * @template TMapSpreadValue
     *
     * @param  callable(mixed...): TMapSpreadValue  $callback
     * @return \Illuminate\Support\Collection<TKey, TMapSpreadValue>
     */
    public function mapSpread(callable $callback) {}

    /**
     * Map the values into a new class.
     *
     * @template TMapIntoValue
     *
     * @param  class-string<TMapIntoValue>  $class
     * @return \Illuminate\Support\Collection<TKey, TMapIntoValue>
     */
    public function mapInto($class) {}

    /**
     * Map a collection and flatten the result by a single level.
     *
     * Eloquent\Collection::collapse() always returns a Support\Collection.
     *
     * @template TFlatMapKey of array-key
     * @template TFlatMapValue
     *
     * @param  callable(TModel, TKey): (\Illuminate\Support\Collection<TFlatMapKey, TFlatMapValue>|array<TFlatMapKey, TFlatMapValue>)  $callback
     * @return \Illuminate\Support\Collection<TFlatMapKey, TFlatMapValue>
     */
    public function flatMap(callable $callback) {}

    /**
     * Create a collection by using this collection for keys and another for its values.
     *
     * The keys are the models themselves, cast to their JSON string at runtime.
     *
     * @template TCombineValue
     *
     * @param  \Illuminate\Contracts\Support\Arrayable<array-key, TCombineValue>|iterable<array-key, TCombineValue>  $values
     * @return \Illuminate\Support\Collection<array-key, TCombineValue>
     */
    public function combine($values) {}

    /**
     * Cross join with the given lists, returning all possible permutations.
     *
     * @template TCrossJoinKey
     * @template TCrossJoinValue
     *
     * @param  \Illuminate\Contracts\Support\Arrayable<TCrossJoinKey, TCrossJoinValue>|iterable<TCrossJoinKey, TCrossJoinValue>  ...$lists
     * @return \Illuminate\Support\Collection<int, array<int, TModel|TCrossJoinValue>>
     */
    public function crossJoin(...$lists) {}

    /**
     * Push all of the given items onto the collection.
     *
     * @template TConcatKey of array-key
     * @template TConcatValue
     *
     * @param  iterable<TConcatKey, TConcatValue>  $source
     * @return \Illuminate\Support\Collection<TKey|TConcatKey, TModel|TConcatValue>
     */
    public function concat($source) {}

    /**
     * Recursively merge the collection with the given items.
     *
     * @template TMergeRecursiveValue
     *
     * @param  \Illuminate\Contracts\Support\Arrayable<TKey, TMergeRecursiveValue>|iterable<TKey, TMergeRecursiveValue>  $items
     * @return \Illuminate\Support\Collection<TKey, TModel|TMergeRecursiveValue>
     */
    public function mergeRecursive($items) {}

    /**
     * Collapse the collection of items into a single array while preserving its keys.
     *
     * Models are neither arrays nor collections, so the result is an empty collection.
     *
     * @return \Illuminate\Support\Collection<array-key, mixed>
     */
    public function collapseWithKeys() {}

    /**
     * Create a new collection by invoking the callback a given amount of times.
     *
     * @template TTimesValue
     *
     * @param  int  $number
     * @param  (callable(int): TTimesValue)|null  $callback
     * @return \Illuminate\Support\Collection<int, TTimesValue>
     */
    public static function times($number, ?callable $callback = null) {}

    /**
     * Select specific values from the items within the collection.
     *
     * Overrides the inherited Support\Collection stub: the non-null branch's items shrink to
     * `array<array-key, mixed>`, which violates `TModel of Model`, so it widens to
     * `Illuminate\Support\Collection` instead — a widening, not a lie, since the object
     * returned by Arr::select()-through-newInstance() genuinely IS-A Support\Collection.
     *
     * @param  \Illuminate\Support\Enumerable<array-key, array-key>|array<array-key, array-key>|string|null  $keys
     * @return ($keys is null ? static<TKey, TModel> : \Illuminate\Support\Collection<TKey, array<array-key, mixed>>)
     *
     * @psalm-variadic
     */
    public function select($keys) {}

    /**
     * Find a model in the collection by key or throw an exception.
     *
     * An array or Arrayable key returns the static collection from find(); any other key returns one model.
     *
     * @template TFindKey
     *
     * @param  TFindKey  $key
     * @psalm-return (TFindKey is \Illuminate\Database\Eloquent\Model ? TModel : (TFindKey is (\Illuminate\Contracts\Support\Arrayable<array-key, mixed>|array<mixed>) ? static<TKey, TModel> : TModel))
     *
     * @throws \Illuminate\Database\Eloquent\ModelNotFoundException
     */
    public function findOrFail($key) {}

    /**
     * Runs on toBase()->pad(), and array_pad() keeps string keys.
     *
     * @template TPadValue
     *
     * @param  int  $size
     * @param  TPadValue  $value
     * @return \Illuminate\Support\Collection<TKey|int, TModel|TPadValue>
     */
    public function pad($size, $value) {}

    /**
     * Runs on toBase()->zip(), and array_map() pads the shorter side with null.
     *
     * @template TZipValue
     *
     * @param  \Illuminate\Contracts\Support\Arrayable<array-key, TZipValue>|iterable<array-key, TZipValue>  $items
     * @return \Illuminate\Support\Collection<int, \Illuminate\Support\Collection<int, TModel|TZipValue|null>>
     *
     * @psalm-variadic
     */
    public function zip($items) {}

    /**
     * Runs on toBase()->flip(), and array_flip() skips object values, so the result is always empty.
     *
     * @return \Illuminate\Support\Collection<array-key, TKey>
     */
    public function flip() {}

    /**
     * array_map() preserves the keys.
     *
     * @return array<TKey, array-key>
     */
    public function modelKeys() {}

    /**
     * Re-declared here because a stub override on `Support\Collection` does not reach subclasses of
     * it for trait methods (vimeo/psalm#12158); see `Illuminate\Support\Collection::tap()` in the
     * Support Collection stub.
     *
     * @param  callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>): mixed  $callback
     * @return $this
     */
    public function tap(callable $callback) {}

    /**
     * @template TPipeReturnType
     *
     * @param  callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>): TPipeReturnType  $callback
     * @return TPipeReturnType
     */
    public function pipe(callable $callback) {}

    /**
     * @template TWhenEmptyReturnType
     *
     * @param  (callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>, bool): (TWhenEmptyReturnType|null))  $callback
     * @param  (callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>, bool): (TWhenEmptyReturnType|null))|null  $default
     * @return (TWhenEmptyReturnType is void ? $this : (TWhenEmptyReturnType is null ? $this : $this|TWhenEmptyReturnType))
     */
    public function whenEmpty(callable $callback, ?callable $default = null) {}

    /**
     * @template TWhenNotEmptyReturnType
     *
     * @param  (callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>, bool): (TWhenNotEmptyReturnType|null))  $callback
     * @param  (callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>, bool): (TWhenNotEmptyReturnType|null))|null  $default
     * @return (TWhenNotEmptyReturnType is void ? $this : (TWhenNotEmptyReturnType is null ? $this : $this|TWhenNotEmptyReturnType))
     */
    public function whenNotEmpty(callable $callback, ?callable $default = null) {}

    /**
     * @template TUnlessEmptyReturnType
     *
     * @param  (callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>, bool): (TUnlessEmptyReturnType|null))  $callback
     * @param  (callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>, bool): (TUnlessEmptyReturnType|null))|null  $default
     * @return (TUnlessEmptyReturnType is void ? $this : (TUnlessEmptyReturnType is null ? $this : $this|TUnlessEmptyReturnType))
     */
    public function unlessEmpty(callable $callback, ?callable $default = null) {}

    /**
     * @template TUnlessNotEmptyReturnType
     *
     * @param  (callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>, bool): (TUnlessNotEmptyReturnType|null))  $callback
     * @param  (callable(\Illuminate\Database\Eloquent\Collection<TKey, TModel>, bool): (TUnlessNotEmptyReturnType|null))|null  $default
     * @return (TUnlessNotEmptyReturnType is void ? $this : (TUnlessNotEmptyReturnType is null ? $this : $this|TUnlessNotEmptyReturnType))
     */
    public function unlessNotEmpty(callable $callback, ?callable $default = null) {}
}
