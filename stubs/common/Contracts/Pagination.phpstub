<?php

namespace Illuminate\Contracts\Pagination;

/**
 * @template TKey of array-key
 * @template-covariant TValue
 */
interface Paginator
{
    /**
     * @return array<TValue>
     */
    public function items(): array;

    /**
     * Get / set the URL fragment to be appended to URLs.
     *
     * Laravel declares the flat `$this|string|null` on every 12.x and on 13.x before 13.18.0,
     * which breaks `->fragment('x')->links()` chains (the next call lands on `string|null`).
     * The conditional keeps the getter `string|null` and the setter chainable. See
     * `AbstractPaginator::fragment()` for why the template is explicit.
     *
     * @template TFragment of string|null
     *
     * @param  TFragment  $fragment
     * @return (TFragment is null ? string|null : $this)
     */
    public function fragment($fragment = null);
}

/**
 * @template TKey of array-key
 * @template-covariant TValue
 *
 * @extends Paginator<TKey, TValue>
 */
interface LengthAwarePaginator extends Paginator
{}

/**
 * @template TKey of array-key
 * @template-covariant TValue
 */
interface CursorPaginator
{
    /**
     * @return array<TValue>
     */
    public function items(): array;

    /**
     * Get / set the URL fragment to be appended to URLs. See `Paginator::fragment()`.
     *
     * @template TFragment of string|null
     *
     * @param  TFragment  $fragment
     * @return (TFragment is null ? string|null : $this)
     */
    public function fragment($fragment = null);
}
