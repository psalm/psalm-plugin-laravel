     * @param  string  $to
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function between($from, $to) {}

    /**
     * @param  string  $from
     * @param  string  $to
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function betweenFirst($from, $to) {}

    /**
     * @return static
     * @psalm-flow ($this) -> return
     */
