    /**
     * @param  string|array  $needle
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function chopEnd($needle) {}

    /**
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function classBasename() {}

    /**
     * @param  string  $search
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function before($search) {}

    /**
     * @param  string  $search
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function beforeLast($search) {}

    /**
