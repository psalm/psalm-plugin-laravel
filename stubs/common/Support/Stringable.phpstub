     * Runtime: Str::is() casts pattern via `(string) $pattern`.
     *
     * @param  string|\Stringable|iterable<string|\Stringable>  $pattern
     * @param  bool  $ignoreCase
     * @return bool
     */
    public function is($pattern, $ignoreCase = false) {}
