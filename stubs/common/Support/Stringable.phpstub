<?php

namespace Illuminate\Support;

use ArrayAccess;
use JsonSerializable;
use Stringable as BaseStringable;

/**
 * Taint flow stubs for Illuminate\Support\Stringable: each method whose result holds the string (or part of it)
 * carries its taint, and the parameters adding to it carry theirs. The methods whose result can't hold the string's
 * characters (`hash()`, `encrypt()`, `toBase64()`, `numbers()`, the predicates and counts) keep Laravel's declaration
 * and drop the taint, like `base64_encode()` in Psalm.
 *
 * Methods added or changed after Laravel 12.27 are declared in the stubs of the version that has them.
 *
 * @psalm-taint-specialize
 */
class Stringable implements JsonSerializable, ArrayAccess, BaseStringable
{
    /**
     * @param  string  $search
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function after($search) {}

    /**
     * @param  string  $search
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function afterLast($search) {}

    /**
     * @param  string  $language
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function ascii($language = 'en') {}

    /**
