<?php

namespace Illuminate\Support;

use ArrayAccess;
use Illuminate\Contracts\Support\CanBeEscapedWhenCastToString;
use Illuminate\Support\Traits\EnumeratesValues;

/**
 * @template TKey of array-key
 * @template TValue
 * @implements \ArrayAccess<TKey, TValue>
 * @implements \Illuminate\Support\Enumerable<TKey, TValue>
 *
 * Psalm does not resolve @property-read from trait template parameters when using @use bindings.
 * These annotations are declared directly here so that TKey/TValue resolve to the class-level
 * template parameters and higher-order proxy method calls are properly typed.
 *
 * The list mirrors EnumeratesValues::$proxies at the lowest supported 12.x — do not edit without checking that array.
 * `$sole` is left out on purpose: Laravel added it in 13.33.0 and declares it in its own docblock there.
 * Note: $hasMany here is a collection method (not an Eloquent relationship).
 * The third proxy argument spells the receiver class out instead of Laravel's `static`: a stub
 * `@property-read` keeps `static` unparameterized (`Collection&static`), losing TKey/TValue.
 *
 * @property-read HigherOrderCollectionProxy<'average', TValue, Collection<TKey, TValue>> $average
 * @property-read HigherOrderCollectionProxy<'avg', TValue, Collection<TKey, TValue>> $avg
 * @property-read HigherOrderCollectionProxy<'contains', TValue, Collection<TKey, TValue>> $contains
 * @property-read HigherOrderCollectionProxy<'doesntContain', TValue, Collection<TKey, TValue>> $doesntContain
 * @property-read HigherOrderCollectionProxy<'each', TValue, Collection<TKey, TValue>> $each
 * @property-read HigherOrderCollectionProxy<'every', TValue, Collection<TKey, TValue>> $every
 * @property-read HigherOrderCollectionProxy<'filter', TValue, Collection<TKey, TValue>> $filter
 * @property-read HigherOrderCollectionProxy<'first', TValue, Collection<TKey, TValue>> $first
 * @property-read HigherOrderCollectionProxy<'flatMap', TValue, Collection<TKey, TValue>> $flatMap
 * @property-read HigherOrderCollectionProxy<'groupBy', TValue, Collection<TKey, TValue>> $groupBy
 * @property-read HigherOrderCollectionProxy<'hasMany', TValue, Collection<TKey, TValue>> $hasMany
 * @property-read HigherOrderCollectionProxy<'hasSole', TValue, Collection<TKey, TValue>> $hasSole
 * @property-read HigherOrderCollectionProxy<'keyBy', TValue, Collection<TKey, TValue>> $keyBy
 * @property-read HigherOrderCollectionProxy<'last', TValue, Collection<TKey, TValue>> $last
 * @property-read HigherOrderCollectionProxy<'map', TValue, Collection<TKey, TValue>> $map
 * @property-read HigherOrderCollectionProxy<'max', TValue, Collection<TKey, TValue>> $max
 * @property-read HigherOrderCollectionProxy<'min', TValue, Collection<TKey, TValue>> $min
 * @property-read HigherOrderCollectionProxy<'partition', TValue, Collection<TKey, TValue>> $partition
 * @property-read HigherOrderCollectionProxy<'percentage', TValue, Collection<TKey, TValue>> $percentage
 * @property-read HigherOrderCollectionProxy<'reject', TValue, Collection<TKey, TValue>> $reject
 * @property-read HigherOrderCollectionProxy<'skipUntil', TValue, Collection<TKey, TValue>> $skipUntil
 * @property-read HigherOrderCollectionProxy<'skipWhile', TValue, Collection<TKey, TValue>> $skipWhile
 * @property-read HigherOrderCollectionProxy<'some', TValue, Collection<TKey, TValue>> $some
 * @property-read HigherOrderCollectionProxy<'sortBy', TValue, Collection<TKey, TValue>> $sortBy
 * @property-read HigherOrderCollectionProxy<'sortByDesc', TValue, Collection<TKey, TValue>> $sortByDesc
 * @property-read HigherOrderCollectionProxy<'sum', TValue, Collection<TKey, TValue>> $sum
 * @property-read HigherOrderCollectionProxy<'takeUntil', TValue, Collection<TKey, TValue>> $takeUntil
 * @property-read HigherOrderCollectionProxy<'takeWhile', TValue, Collection<TKey, TValue>> $takeWhile
 * @property-read HigherOrderCollectionProxy<'unique', TValue, Collection<TKey, TValue>> $unique
 * @property-read HigherOrderCollectionProxy<'unless', TValue, Collection<TKey, TValue>> $unless
 * @property-read HigherOrderCollectionProxy<'until', TValue, Collection<TKey, TValue>> $until
 * @property-read HigherOrderCollectionProxy<'when', TValue, Collection<TKey, TValue>> $when
 */
class Collection implements ArrayAccess, CanBeEscapedWhenCastToString, Enumerable
{
    /**
     * @use \Illuminate\Support\Traits\EnumeratesValues<TKey, TValue>
     */
    use EnumeratesValues;

    /**
     * Create a new instance with no items.
     *
     * @psalm-mutation-free
     * @return static<never, never>
     */
    public static function empty() {}

    /**
     * Get the first item from the collection passing the given truth test.
     *
     * @psalm-mutation-free
     *
     * @template TFirstDefault
     * @template TFirstDefaultFromClosure
     *
     * @param  (callable(TValue, TKey): bool)|null  $callback
     * @param  TFirstDefault|(\Closure(): TFirstDefaultFromClosure)  $default
     * @return ($default is \Closure ? TFirstDefaultFromClosure : (TFirstDefault | TValue))
     *
     * @psalm-flow ($default) -> return
     * @psalm-taint-specialize
     */
    public function first(callable $callback = null, $default = null) {}

    /**
     * @psalm-mutation-free
     *
     * @template TGetDefault
     * @template TGetClosureReturn
     *
     * @param  TKey|null  $key
     * @param  TGetDefault|(\Closure(): TGetClosureReturn)  $default
     * @return ($default is \Closure ? TGetClosureReturn : (TGetDefault | TValue))
     *
     * @psalm-flow ($default) -> return
     * @psalm-taint-specialize
     */
    public function get($key, $default = null) {}

    /**
     * Get the last item from the collection.
     *
     * A closure default only runs when no item matches, so its result joins `TValue`.
     *
     * @psalm-mutation-free
     *
     * @template TLastDefault
     * @template TLastClosureReturn
     *
     * @param  (callable(TValue, TKey): bool)|null  $callback
     * @param  TLastDefault|(\Closure(): TLastClosureReturn)  $default
     * @return ($default is \Closure ? TLastClosureReturn|TValue : (TLastDefault | TValue))
     *
     * @psalm-flow ($default) -> return
     * @psalm-taint-specialize
     */
    public function last(?callable $callback = null, $default = null) {}

    /**
     * @template TCount of int
     * @param  TCount  $count
     * @return (
     *     TCount is 1
     *     ? TValue|null
     *     : static<int, TValue>
     * )
     */
    public function pop($count = 1) {}

    /**
     * @template TPullDefault
     * @template TPullClosureReturn
     *
     * @param  TKey  $key
     * @param  TPullDefault|(\Closure(): TPullClosureReturn)  $default
     * @return ($default is \Closure ? TPullClosureReturn|TValue : (TPullDefault | TValue))
     *
     * @psalm-flow ($default) -> return
     * @psalm-taint-specialize
     */
    public function pull($key, $default = null) {}

    /**
     * Get a value from the first item in the collection.
     *
     * @psalm-mutation-free
     *
     * @param  string|int  $key
     * @param  mixed  $default
     * @return mixed
     *
     * @psalm-flow ($default) -> return
     * @psalm-taint-specialize
     */
    public function value($key, $default = null) {}

    /**
     * @psalm-mutation-free
     *
     * `$preserveKeys = true` keeps the source keys; any other number result is re-indexed.
     *
     * @param  (callable(self<TKey, TValue>): int)|int|null  $number
     * @param  bool  $preserveKeys
     * @return ($number is null ? TValue : ($preserveKeys is true ? static<TKey, TValue> : static<int, TValue>))
     *
     * @throws \InvalidArgumentException
     */
    public function random($number = null, $preserveKeys = false) {}

    /**
     * @psalm-mutation-free
     *
     * @param  TValue|(callable(TValue,TKey): bool)  $value
     * @param  bool  $strict
     * @return TKey|false
     */
    public function search($value, $strict = false) {}

    /**
     * @template TCount of int
     * @param  TCount  $count
     * @return (
     *     TCount is 1
     *     ? TValue|null
     *     : static<int, TValue>
     * )
     */
    public function shift($count = 1) {}

    /**
     * Shuffled items are renumbered (the runtime shuffles into a list).
     *
     * @return static<int, TValue>
     */
    public function shuffle() {}

    /**
     * Appends each item with `push()`, so the source keys are discarded and appended items get
     * int keys.
     *
     * @template TConcatValue
     *
     * @param  iterable<array-key, TConcatValue>  $source
     * @return static<TKey|int, TValue|TConcatValue>
     */
    public function concat($source) {}

    /**
     * Merge the collection with the given items.
     *
     * Uses an independent key template `TMergeKey` rather than constraining input keys to `TKey`.
     * This allows `Collection<never, never>::merge(Collection<int, string>)` to return
     * `Collection<int, string>` instead of failing with a key-type mismatch.
     *
     * @template TMergeKey of array-key
     * @template TMergeValue
     *
     * @param  \Illuminate\Contracts\Support\Arrayable<TMergeKey, TMergeValue>|iterable<TMergeKey, TMergeValue>  $items
     * @return static<TKey|TMergeKey, TValue|TMergeValue>
     */
    public function merge($items) {}

    /**
     * Push items onto the end of the collection.
     *
     * Uses an independent value template `TPushValue` so that calling `push()` on a
     * `Collection<never, never>` widens the return type to include the concrete pushed value.
     * Both fluent chains (`collect()->push($x)->push($y)`) and the mutable accumulator
     * pattern (`$c = collect(); $c->push($x); $c->each(...)`) propagate types correctly.
     * `@psalm-this-out` updates the variable type for the mutable accumulator pattern.
     *
     * @template TPushValue
     *
     * @param  TPushValue  ...$values
     * @psalm-this-out static<TKey|int, TValue|TPushValue>
     * @return static<TKey|int, TValue|TPushValue>
     */
    public function push(...$values) {}

    /**
     * Set the item at a given offset.
     *
     * Uses independent key/value templates so calling `put()` on a `Collection<never, never>`
     * widens the return type to include the concrete inserted key and value.
     * Both fluent chains (`collect()->put($k, $v)->each(...)`) and the mutable accumulator
     * pattern (`$c = collect(); $c->put($k, $v); $c->each(...)`) propagate types correctly.
     * `@psalm-this-out` updates the variable type for the mutable accumulator pattern,
     * fixing false-positive InvalidArgument and ReservedWord errors (see issue #723).
     *
     * @template TPutKey of array-key
     * @template TPutValue
     *
     * @param  TPutKey  $key
     * @param  TPutValue  $value
     * @psalm-this-out static<TKey|TPutKey, TValue|TPutValue>
     * @return static<TKey|TPutKey, TValue|TPutValue>
     */
    public function put($key, $value) {}

    /**
     * Push an item onto the beginning of the collection.
     *
     * Same model as push()/put(): independent templates plus `@psalm-this-out`, so a value (or key)
     * outside the current types widens the collection instead of raising InvalidArgument.
     *
     * Laravel branches on the argument count, not on null: `prepend($v)` gets an integer key, while
     * `prepend($v, null)` inserts the string key `''`.
     *
     * @template TPrependValue
     * @template TPrependKey of array-key
     *
     * @param  TPrependValue  $value
     * @param  TPrependKey|null  $key
     * @psalm-this-out static<(func_num_args() is 1 ? TKey|int : ($key is null ? TKey|'' : TKey|TPrependKey)), TValue|TPrependValue>
     * @return static<(func_num_args() is 1 ? TKey|int : ($key is null ? TKey|'' : TKey|TPrependKey)), TValue|TPrependValue>
     */
    public function prepend($value, $key = null) {}

    /**
     * Prepend one or more items to the beginning of the collection.
     *
     * @template TUnshiftValue
     *
     * @param  TUnshiftValue  ...$values
     * @psalm-this-out static<TKey|int, TValue|TUnshiftValue>
     * @return static<TKey|int, TValue|TUnshiftValue>
     */
    public function unshift(...$values) {}

    /**
     * Add an item to the collection.
     *
     * @template TAddValue
     *
     * @param  TAddValue  $item
     * @psalm-this-out static<TKey|int, TValue|TAddValue>
     * @return static<TKey|int, TValue|TAddValue>
     */
    public function add($item) {}

    /**
     * Splice a portion of the underlying collection array.
     *
     * Returns the removed slice (original items), while the receiver gains the replacement values.
     * The receiver's key type stays `TKey` as in Laravel: array_splice() also renumbers integer keys
     * and gives the replacement integer keys, which is not modelled here.
     *
     * @template TSpliceValue
     *
     * @param  int  $offset
     * @param  int|null  $length
     * @param  array<array-key, TSpliceValue>  $replacement
     * @psalm-this-out static<TKey, TValue|TSpliceValue>
     * @return static<TKey, TValue>
     */
    public function splice($offset, $length = null, $replacement = []) {}

    /**
     * Get an item from the collection by key or add it to the collection if it does not exist.
     *
     * The key is deliberately unbounded: Laravel declares `mixed`, and null, bool and float keys are
     * accepted at runtime (coerced by PHP). A non-array-key argument widens the key type to `array-key`.
     *
     * Psalm cannot decide `\Closure` against interfaces, iterables or templates, so the guards first rule
     * out non-callable values and only then split on `\Closure`. An unbounded template argument stays
     * silent although it may hold a Closure, and an invokable-interface value gains `|mixed` (Psalm does not treat
     * `Closure` as final in conditional types); see GetOrPutClosureDefaultKnownLimitation.phpt.
     *
     * @template TGetOrPutKey
     * @template TGetOrPutValue
     * @template TGetOrPutClosureReturn
     *
     * @param  TGetOrPutKey  $key
     * @param  TGetOrPutValue|(\Closure(): TGetOrPutClosureReturn)  $value
     * @psalm-this-out static<TKey|(TGetOrPutKey is array-key ? TGetOrPutKey : array-key), TValue|($value is scalar|array|null ? TGetOrPutValue : ($value is callable ? ($value is \Closure ? TGetOrPutClosureReturn : TGetOrPutValue) : TGetOrPutValue))>
     * @return TValue|($value is scalar|array|null ? TGetOrPutValue : ($value is callable ? ($value is \Closure ? TGetOrPutClosureReturn : TGetOrPutValue) : TGetOrPutValue))
     */
    public function getOrPut($key, $value) {}

    /**
     * Count the number of items in the collection.
     *
     * @psalm-mutation-free
     * @return int<0, max>
     */
    public function count(): int {}

    /**
     * Determine if the collection is empty or not.
     *
     * @psalm-mutation-free
     * @psalm-assert-if-true null $this->first()
     * @psalm-assert-if-true 0 $this->count()
     * @psalm-assert-if-false positive-int $this->count()
     * @return bool
     */
    public function isEmpty() {}

    /**
     * Determine if the collection is not empty.
     *
     * @psalm-mutation-free
     * @return bool
     */
    public function isNotEmpty() {}

    /**
     * Create a collection by using this collection for keys and another for its values.
     *
     * @template TCombineValue
     *
     * @param  \Illuminate\Contracts\Support\Arrayable<array-key, TCombineValue>|iterable<array-key, TCombineValue>  $values
     * @return static<array-key, TCombineValue>
     */
    public function combine($values) {}

    /**
     * Group an associative array by a field or using a callback.
     *
     * @template TGroupKey of array-key|\UnitEnum|\Stringable
     *
     * @param  (callable(TValue, TKey): TGroupKey)|array|string  $groupBy
     * @param  bool  $preserveKeys
     * @return static<
     *  ($groupBy is (array|string)
     *      ? array-key
     *      : (TGroupKey is \UnitEnum ? array-key : (TGroupKey is \Stringable ? string : TGroupKey))),
     *  static<($preserveKeys is true ? TKey : int), ($groupBy is array ? mixed : TValue)>
     * >
     */
    public function groupBy($groupBy, $preserveKeys = false) {}

    /**
     * Key an associative array by a field or using a callback.
     *
     * @template TNewKey of array-key|\UnitEnum
     *
     * @param  (callable(TValue, TKey): TNewKey)|array|string  $keyBy
     * @return static<($keyBy is (array|string) ? array-key : (TNewKey is \UnitEnum ? array-key : TNewKey)), TValue>
     */
    public function keyBy($keyBy) {}

    /**
     * Chunk the collection into chunks with a callback.
     *
     * The chunk is a plain `Collection` (built by `LazyCollection::chunkWhile()`); it becomes `static`
     * only after the callback ran. Laravel's `static<TKey, TValue>` leaves an untyped closure param
     * as an unresolved `static`, which the check then rejects.
     *
     * @param  callable(TValue, TKey, \Illuminate\Support\Collection<TKey, TValue>): bool  $callback
     * @return static<int, static<TKey, TValue>>
     */
    public function chunkWhile(callable $callback) {}

    /**
     * Laravel's `callable($this)` gives an untyped closure param the unresolved `static` (the
     * enclosing class inside a class body), so every untyped closure was rejected. The callbacks
     * below name the class with its templates instead. These stubs reach `Collection` itself only:
     * a subclass keeps the `EnumeratesValues` declaration (vimeo/psalm#12158).
     *
     * @param  callable(\Illuminate\Support\Collection<TKey, TValue>): mixed  $callback
     * @return $this
     */
    public function tap(callable $callback) {}

    /**
     * @template TPipeReturnType
     *
     * @param  callable(\Illuminate\Support\Collection<TKey, TValue>): TPipeReturnType  $callback
     * @return TPipeReturnType
     */
    public function pipe(callable $callback) {}

    /**
     * The whenEmpty() family runs `when($condition, $callback, $default)`, which passes the condition
     * as the second argument and returns `$callback(...) ?? $this`. The callable return is
     * `T|null` so a null or void callback leaves only `$this`.
     * Each callable is declared with and without the `bool` parameter because Psalm rejects a non-closure
     * callable with fewer params than the declared one (UnionTypeComparator arity rule). Caveat: the
     * single-param arm also accepts a callable with an optional non-bool 2nd param, which Laravel then
     * calls with a bool. That arm is listed first on purpose: the order decides which issue type Psalm
     * reports for a mismatched 2nd param (InvalidArgument, not InvalidScalarArgument).
     *
     * @template TWhenEmptyReturnType
     *
     * @param  (callable(\Illuminate\Support\Collection<TKey, TValue>): (TWhenEmptyReturnType|null))|(callable(\Illuminate\Support\Collection<TKey, TValue>, bool): (TWhenEmptyReturnType|null))  $callback
     * @param  (callable(\Illuminate\Support\Collection<TKey, TValue>): (TWhenEmptyReturnType|null))|(callable(\Illuminate\Support\Collection<TKey, TValue>, bool): (TWhenEmptyReturnType|null))|null  $default
     * @return (TWhenEmptyReturnType is void ? $this : (TWhenEmptyReturnType is null ? $this : $this|TWhenEmptyReturnType))
     */
    public function whenEmpty(callable $callback, ?callable $default = null) {}

    /**
     * @template TWhenNotEmptyReturnType
     *
     * @param  (callable(\Illuminate\Support\Collection<TKey, TValue>): (TWhenNotEmptyReturnType|null))|(callable(\Illuminate\Support\Collection<TKey, TValue>, bool): (TWhenNotEmptyReturnType|null))  $callback
     * @param  (callable(\Illuminate\Support\Collection<TKey, TValue>): (TWhenNotEmptyReturnType|null))|(callable(\Illuminate\Support\Collection<TKey, TValue>, bool): (TWhenNotEmptyReturnType|null))|null  $default
     * @return (TWhenNotEmptyReturnType is void ? $this : (TWhenNotEmptyReturnType is null ? $this : $this|TWhenNotEmptyReturnType))
     */
    public function whenNotEmpty(callable $callback, ?callable $default = null) {}

    /**
     * @template TUnlessEmptyReturnType
     *
     * @param  (callable(\Illuminate\Support\Collection<TKey, TValue>): (TUnlessEmptyReturnType|null))|(callable(\Illuminate\Support\Collection<TKey, TValue>, bool): (TUnlessEmptyReturnType|null))  $callback
     * @param  (callable(\Illuminate\Support\Collection<TKey, TValue>): (TUnlessEmptyReturnType|null))|(callable(\Illuminate\Support\Collection<TKey, TValue>, bool): (TUnlessEmptyReturnType|null))|null  $default
     * @return (TUnlessEmptyReturnType is void ? $this : (TUnlessEmptyReturnType is null ? $this : $this|TUnlessEmptyReturnType))
     */
    public function unlessEmpty(callable $callback, ?callable $default = null) {}

    /**
     * @template TUnlessNotEmptyReturnType
     *
     * @param  (callable(\Illuminate\Support\Collection<TKey, TValue>): (TUnlessNotEmptyReturnType|null))|(callable(\Illuminate\Support\Collection<TKey, TValue>, bool): (TUnlessNotEmptyReturnType|null))  $callback
     * @param  (callable(\Illuminate\Support\Collection<TKey, TValue>): (TUnlessNotEmptyReturnType|null))|(callable(\Illuminate\Support\Collection<TKey, TValue>, bool): (TUnlessNotEmptyReturnType|null))|null  $default
     * @return (TUnlessNotEmptyReturnType is void ? $this : (TUnlessNotEmptyReturnType is null ? $this : $this|TUnlessNotEmptyReturnType))
     */
    public function unlessNotEmpty(callable $callback, ?callable $default = null) {}

    /**
     * Get the sum of the given values.
     *
     * At runtime, the accumulator starts at int 0 and adds with the + operator, so the result is
     * always int|float (a non-numeric string throws TypeError, a numeric string is added as a number)
     * and an empty collection yields int 0 whatever the item type. Only an int source narrows:
     * - Collection<_, int>::sum() → int
     * - Collection<_, float>::sum() → int|float (empty collection)
     * - Otherwise → int|float
     *
     * The callback is called with the item only on every 12.x release; 13.x also passes the key
     * (`stubs/13/`).
     *
     * @template TCallbackReturn of int|float|numeric-string
     *
     * @param  (callable(TValue): TCallbackReturn)|string|null  $callback
     * @return ($callback is null
     *  ? (TValue is int ? int : int|float)
     *  : ($callback is string ? int|float : (TCallbackReturn is int ? int : int|float))
     * )
     */
    public function sum($callback = null) {}

    /**
     * Pad collection to the specified length with a value.
     *
     * array_pad() keeps string keys and renumbers int keys, so the key type is `TKey|int`
     * (Laravel's docblock declares `int`).
     *
     * @template TPadValue
     *
     * @param  int  $size
     * @param  TPadValue  $value
     * @return static<TKey|int, TValue|TPadValue>
     */
    public function pad($size, $value) {}

    /**
     * Determine if an item exists in the collection by key.
     *
     * Accepts an array of keys or variadic key arguments via func_get_args().
     *
     * @param  TKey|array<array-key, TKey>  $key
     * @return bool
     *
     * @psalm-variadic
     */
    public function has($key) {}

    /**
     * Determine if any of the keys exist in the collection.
     *
     * Accepts an array of keys or variadic key arguments via func_get_args().
     *
     * @param  TKey|array<array-key, TKey>  $key
     * @return bool
     *
     * @psalm-variadic
     */
    public function hasAny($key) {}

    /**
     * Get all items except for those with the specified keys.
     *
     * Accepts an array/Enumerable of keys or variadic key arguments via func_get_args().
     *
     * @param  \Illuminate\Support\Enumerable<array-key, TKey>|array<array-key, TKey>|string  $keys
     * @return static
     *
     * @psalm-variadic
     */
    public function except($keys) {}

    /**
     * Get the items with the specified keys.
     *
     * Accepts an array/Enumerable of keys or variadic key arguments via func_get_args().
     *
     * @param  \Illuminate\Support\Enumerable<array-key, TKey>|array<array-key, TKey>|string|null  $keys
     * @return static
     *
     * @psalm-variadic
     */
    public function only($keys) {}

    /**
     * Determine if an item is not contained in the collection.
     *
     * Accepts extra positional args beyond ($key, $operator, $value); they are
     * forwarded to contains() via func_get_args().
     *
     * @param  (callable(TValue, TKey): bool)|TValue|array-key  $key
     * @param  mixed  $operator
     * @param  mixed  $value
     * @return bool
     *
     * @psalm-variadic
     */
    public function doesntContain($key, $operator = null, $value = null) {}

    /**
     * Determine if an item is not contained in the collection using strict comparison.
     *
     * Accepts extra positional args beyond ($key, $operator, $value) and forwards
     * them to containsStrict() via func_get_args(). The third parameter mirrors
     * Laravel's signature even though containsStrict() only consumes two.
     *
     * @param  (callable(TValue, TKey): bool)|TValue|array-key  $key
     * @param  mixed  $operator
     * @param  mixed  $value
     * @return bool
     *
     * @psalm-variadic
     */
    public function doesntContainStrict($key, $operator = null, $value = null) {}

    /**
     * Zip the collection together with one or more arrays.
     *
     * Accepts variadic iterables via func_get_args().
     * array_map() pads the shorter side with null.
     *
     * @template TZipValue
     *
     * @param  \Illuminate\Contracts\Support\Arrayable<array-key, TZipValue>|iterable<array-key, TZipValue>  $items
     * @return static<int, static<int, TValue|TZipValue|null>>
     *
     * @psalm-variadic
     */
    public function zip($items) {}

    /**
     * Select specific values from the items within the collection.
     *
     * Arr::select() maps every item to an array holding only the requested keys and
     * preserves the outer keys; a null $keys short-circuits to the untouched collection.
     * The per-item shape depends on the literal key list, which a docblock cannot express.
     *
     * @param  \Illuminate\Support\Enumerable<array-key, array-key>|array<array-key, array-key>|string|null  $keys
     * @return ($keys is null ? static<TKey, TValue> : static<TKey, array<array-key, mixed>>)
     *
     * @psalm-variadic
     */
    public function select($keys) {}
}
