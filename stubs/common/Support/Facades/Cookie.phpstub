<?php

namespace Illuminate\Support\Facades;

class Cookie extends Facade
{
    /**
     * Get a queued cookie instance.
     *
     * Psalm cannot decide `\Closure` against an unbounded template, so the guards first rule out
     * non-callable defaults and only then split on `\Closure`. Since Psalm 7.14 (vimeo/psalm#12672) such
     * an argument, which may hold a Closure, resolves to `mixed`; see
     * GetOrPutClosureDefaultUnboundedTemplateTest.phpt. Interfaces, iterables and bounded templates are
     * decided since Psalm 7.12 (vimeo/psalm#12497); the invokable-interface case is pinned by
     * GetOrPutInvokableInterfaceDefaultTest.phpt.
     *
     * @template TQueuedDefault
     * @template TQueuedClosureReturn
     *
     * @param  string  $key
     * @param  TQueuedDefault|(\Closure(): TQueuedClosureReturn)  $default
     * @param  string|null  $path
     * @return \Symfony\Component\HttpFoundation\Cookie|($default is scalar|array|null ? TQueuedDefault : ($default is callable ? ($default is \Closure ? TQueuedClosureReturn : TQueuedDefault) : TQueuedDefault))
     */
    public static function queued($key, $default = null, $path = null) {}
}
