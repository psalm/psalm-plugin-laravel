<?php

namespace Illuminate\Support;

/**
 * @template TKey of array-key
 * @template-covariant TValue
 *
 * @extends \IteratorAggregate<TKey, TValue>
 * @extends \Illuminate\Contracts\Support\Arrayable<TKey, TValue>
 */
interface Enumerable extends \Illuminate\Contracts\Support\Arrayable, \Illuminate\Contracts\Support\Jsonable, \Countable, \IteratorAggregate, \JsonSerializable
{
    /**
     * Get one or a specified number of items randomly from the collection.
     *
     * No argument → a single random element (TValue). With $number → a
     * sub-collection (static<int, TValue>). Mirrors the conditional already
     * shipped on Collection so Enumerable-typed callers keep the narrowing
     * instead of falling back to Laravel's reflected static<int, TValue>|TValue.
     *
     * Unused method template: workaround for vimeo/psalm#11837, a conditional return in a stub
     * that re-declares a reflected method otherwise collapses to its first branch.
     *
     * @template TUnused
     *
     * @param  int|null  $number
     * @return ($number is null ? TValue : static<int, TValue>)
     *
     * @throws \InvalidArgumentException
     */
    public function random($number = null);

    /**
     * Get the sum of the given values.
     *
     * At runtime, the accumulator starts at int 0 and adds with the + operator, so the result is
     * always int|float (a non-numeric string throws TypeError, a numeric string is added as a number)
     * and an empty collection yields int 0 whatever the item type. Only an int source narrows:
     * - Collection<_, int>::sum() → int
     * - Collection<_, float>::sum() → int|float (empty collection)
     * - Otherwise → int|float
     *
     * The callback is called with the item only on every 12.x release; 13.x also passes the key
     * (`stubs/13/`).
     *
     * @template TCallbackReturn of int|float|numeric-string
     *
     * @param  (callable(TValue): TCallbackReturn)|string|null  $callback
     * @return ($callback is null
     *  ? (TValue is int ? int : int|float)
     *  : ($callback is string ? int|float : (TCallbackReturn is int ? int : int|float))
     * )
     */
    public function sum($callback = null);

    /**
     * Same widening as the `Collection` stub (see the note there).
     *
     * @template TPadValue
     *
     * @param  int  $size
     * @param  TPadValue  $value
     * @return static<TKey|int, TValue|TPadValue>
     */
    public function pad($size, $value);

    /**
     * Same conditional as the `EnumeratesValues` trait stub (see the note there).
     *
     * @template TMaxResult
     *
     * @param  (callable(TValue): TMaxResult)|string|null  $callback
     * @return ($callback is null ? TValue|null : ($callback is string ? mixed : TMaxResult|null))
     */
    public function max($callback = null);

    /**
     * @template TMinResult
     *
     * @param  (callable(TValue): TMinResult)|string|null  $callback
     * @return ($callback is null ? TValue|null : ($callback is string ? mixed : TMinResult|null))
     */
    public function min($callback = null);

    /**
     * Same widening as the `EnumeratesValues` trait stub (see the note there).
     *
     * @template TFlatMapKey of array-key
     * @template TFlatMapValue
     *
     * @param  callable(TValue, TKey): (\Illuminate\Support\Collection<TFlatMapKey, TFlatMapValue>|array<TFlatMapKey, TFlatMapValue>)  $callback
     * @return static<(TFlatMapKey is int ? int : TFlatMapKey), TFlatMapValue>
     */
    public function flatMap(callable $callback);

    /**
     * Same closure-default handling as `LazyCollection::get()`.
     *
     * @template TGetDefault
     * @template TGetClosureReturn
     *
     * @param  TKey  $key
     * @param  TGetDefault|(\Closure(): TGetClosureReturn)  $default
     * @return ($default is \Closure ? TGetClosureReturn|TValue : (TGetDefault | TValue))
     */
    public function get($key, $default = null);
}
