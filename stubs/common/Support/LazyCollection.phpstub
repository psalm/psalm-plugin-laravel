<?php

namespace Illuminate\Support;

use Illuminate\Contracts\Support\CanBeEscapedWhenCastToString;
use Illuminate\Support\Traits\EnumeratesValues;

/**
 * @template TKey of array-key
 * @template-covariant TValue
 * @implements \Illuminate\Support\Enumerable<TKey, TValue>
 *
 * Psalm does not resolve @property-read from trait template parameters when using @use bindings.
 * These annotations are declared directly here so that TKey/TValue resolve to the class-level
 * template parameters and higher-order proxy method calls are properly typed.
 *
 * The list mirrors EnumeratesValues::$proxies at the 12.20 floor — do not edit without checking that array.
 * `$sole` is left out on purpose: Laravel added it in 13.33.0 and declares it in its own docblock there.
 * Note: $hasMany here is a collection method (not an Eloquent relationship).
 * The third proxy argument spells the receiver class out instead of Laravel's `static`: a stub
 * `@property-read` keeps `static` unparameterized (`LazyCollection&static`), losing TKey/TValue.
 *
 * @property-read HigherOrderCollectionProxy<'average', TValue, LazyCollection<TKey, TValue>> $average
 * @property-read HigherOrderCollectionProxy<'avg', TValue, LazyCollection<TKey, TValue>> $avg
 * @property-read HigherOrderCollectionProxy<'contains', TValue, LazyCollection<TKey, TValue>> $contains
 * @property-read HigherOrderCollectionProxy<'doesntContain', TValue, LazyCollection<TKey, TValue>> $doesntContain
 * @property-read HigherOrderCollectionProxy<'each', TValue, LazyCollection<TKey, TValue>> $each
 * @property-read HigherOrderCollectionProxy<'every', TValue, LazyCollection<TKey, TValue>> $every
 * @property-read HigherOrderCollectionProxy<'filter', TValue, LazyCollection<TKey, TValue>> $filter
 * @property-read HigherOrderCollectionProxy<'first', TValue, LazyCollection<TKey, TValue>> $first
 * @property-read HigherOrderCollectionProxy<'flatMap', TValue, LazyCollection<TKey, TValue>> $flatMap
 * @property-read HigherOrderCollectionProxy<'groupBy', TValue, LazyCollection<TKey, TValue>> $groupBy
 * @property-read HigherOrderCollectionProxy<'hasMany', TValue, LazyCollection<TKey, TValue>> $hasMany
 * @property-read HigherOrderCollectionProxy<'hasSole', TValue, LazyCollection<TKey, TValue>> $hasSole
 * @property-read HigherOrderCollectionProxy<'keyBy', TValue, LazyCollection<TKey, TValue>> $keyBy
 * @property-read HigherOrderCollectionProxy<'last', TValue, LazyCollection<TKey, TValue>> $last
 * @property-read HigherOrderCollectionProxy<'map', TValue, LazyCollection<TKey, TValue>> $map
 * @property-read HigherOrderCollectionProxy<'max', TValue, LazyCollection<TKey, TValue>> $max
 * @property-read HigherOrderCollectionProxy<'min', TValue, LazyCollection<TKey, TValue>> $min
 * @property-read HigherOrderCollectionProxy<'partition', TValue, LazyCollection<TKey, TValue>> $partition
 * @property-read HigherOrderCollectionProxy<'percentage', TValue, LazyCollection<TKey, TValue>> $percentage
 * @property-read HigherOrderCollectionProxy<'reject', TValue, LazyCollection<TKey, TValue>> $reject
 * @property-read HigherOrderCollectionProxy<'skipUntil', TValue, LazyCollection<TKey, TValue>> $skipUntil
 * @property-read HigherOrderCollectionProxy<'skipWhile', TValue, LazyCollection<TKey, TValue>> $skipWhile
 * @property-read HigherOrderCollectionProxy<'some', TValue, LazyCollection<TKey, TValue>> $some
 * @property-read HigherOrderCollectionProxy<'sortBy', TValue, LazyCollection<TKey, TValue>> $sortBy
 * @property-read HigherOrderCollectionProxy<'sortByDesc', TValue, LazyCollection<TKey, TValue>> $sortByDesc
 * @property-read HigherOrderCollectionProxy<'sum', TValue, LazyCollection<TKey, TValue>> $sum
 * @property-read HigherOrderCollectionProxy<'takeUntil', TValue, LazyCollection<TKey, TValue>> $takeUntil
 * @property-read HigherOrderCollectionProxy<'takeWhile', TValue, LazyCollection<TKey, TValue>> $takeWhile
 * @property-read HigherOrderCollectionProxy<'unique', TValue, LazyCollection<TKey, TValue>> $unique
 * @property-read HigherOrderCollectionProxy<'unless', TValue, LazyCollection<TKey, TValue>> $unless
 * @property-read HigherOrderCollectionProxy<'until', TValue, LazyCollection<TKey, TValue>> $until
 * @property-read HigherOrderCollectionProxy<'when', TValue, LazyCollection<TKey, TValue>> $when
 */
class LazyCollection implements CanBeEscapedWhenCastToString, Enumerable
{
    /**
     * @use \Illuminate\Support\Traits\EnumeratesValues<TKey, TValue>
     */
    use EnumeratesValues;

    /**
     * Create a new instance with no items.
     *
     * @psalm-mutation-free
     * @return static<never, never>
     */
    public static function empty() {}

    /**
     * Create a new collection instance if the value isn't one already.
     *
     * Keeps the closure-generator and self<...> branches from Laravel's own docblock (they give
     * template binding for the lazy-generator construction form for free) and widens with
     * `scalar|UnitEnum|object` to cover the same runtime-accepted inputs as `Collection::make()` -
     * `EnumeratesValues::getArrayableItems()` routes `null|scalar|UnitEnum` through `Arr::wrap()`
     * and any other object through `Arr::from()` (see issue #808). Precision for what
     * TMakeKey/TMakeValue resolve to in those cases comes from `CollectionMakeHandler`,
     * not this docblock.
     *
     * @template TMakeKey of array-key
     * @template TMakeValue
     *
     * `...$args` is claimed unconditionally: it's real since Laravel 13.3.0 (now the 13.x floor
     * - see composer.json), and on the 12.x floor (12.20+) PHP silently ignores excess call-site
     * arguments beyond the native parameter list, so the wider claim is harmless there too.
     *
     * Known limitation: a bare (non-closure) `Generator` passed directly - e.g. `make($generator)` -
     * type-checks clean here via the `iterable<TMakeKey, TMakeValue>` branch, but Laravel's runtime
     * throws `InvalidArgumentException` for it (only the closure-returning-a-generator form is
     * accepted). `iterable` can't be narrowed to "Traversable minus Generator" in Psalm's type
     * algebra, and Laravel's own docblock has the same imprecision.
     *
     * @param  \Illuminate\Contracts\Support\Arrayable<TMakeKey, TMakeValue>|iterable<TMakeKey, TMakeValue>|(\Closure(): \Generator<TMakeKey, TMakeValue, mixed, void>)|self<TMakeKey, TMakeValue>|scalar|\UnitEnum|object|null  $items
     * @return static<TMakeKey, TMakeValue>
     */
    public static function make($items = [], ...$args) {}

    /**
     * A closure default only runs when the key is missing, so its result joins `TValue`; Laravel's
     * single default template binds to the Closure itself when one is passed. A null key returns
     * null early without evaluating the default (unlike `Collection::get()`, which looks up `''`).
     *
     * @psalm-mutation-free
     *
     * @template TGetDefault
     * @template TGetClosureReturn
     *
     * @param  TKey|null  $key
     * @param  TGetDefault|(\Closure(): TGetClosureReturn)  $default
     * @return ($key is null ? null : ($default is \Closure ? TGetClosureReturn|TValue : (TGetDefault | TValue)))
     *
     * @psalm-flow ($default) -> return
     */
    public function get($key, $default = null) {}

    /**
     * Get one or a specified number of items randomly from the collection.
     *
     * No argument → a single random element (TValue). With $number → a
     * sub-collection (static<int, TValue>). Mirrors the conditional already
     * shipped on Collection so LazyCollection-typed callers keep the narrowing
     * instead of falling back to Laravel's reflected static<int, TValue>|TValue.
     *
     * Unlike Enumerable::random, LazyCollection carries the $preserveKeys second
     * parameter (it forwards func_get_args() to Collection::random) — matched
     * here against Laravel source.
     *
     * Unused method template: workaround for vimeo/psalm#11837, a conditional return in a stub
     * that re-declares a reflected method otherwise collapses to its first branch.
     *
     * `$preserveKeys = true` keeps the source keys; any other number result is re-indexed.
     *
     * @template TUnused
     *
     * @param  int|null  $number
     * @param  bool  $preserveKeys
     * @return ($number is null ? TValue : ($preserveKeys is true ? static<TKey, TValue> : static<int, TValue>))
     *
     * @throws \InvalidArgumentException
     */
    public function random($number = null, $preserveKeys = false) {}

    /**
     * Determine if an item exists in the enumerable by key.
     *
     * Accepts an array of keys or variadic key arguments via func_get_args().
     *
     * @param  TKey|array<array-key, TKey>  $key
     * @return bool
     *
     * @psalm-variadic
     */
    public function has($key) {}

    /**
     * Determine if any of the keys exist in the enumerable.
     *
     * Accepts an array of keys or variadic key arguments via func_get_args().
     *
     * @param  TKey|array<array-key, TKey>  $key
     * @return bool
     *
     * @psalm-variadic
     */
    public function hasAny($key) {}

    /**
     * Select specific values from the items within the collection.
     *
     * Arr::select() maps every item to an array holding only the requested keys and
     * preserves the outer keys; a null $keys short-circuits to the untouched collection.
     * The per-item shape depends on the literal key list, which a docblock cannot express.
     *
     * @param  \Illuminate\Support\Enumerable<array-key, array-key>|array<array-key, array-key>|string|null  $keys
     * @return ($keys is null ? static<TKey, TValue> : static<TKey, array<array-key, mixed>>)
     *
     * @psalm-variadic
     */
    public function select($keys) {}
}
