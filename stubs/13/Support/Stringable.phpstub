<?php

namespace Illuminate\Support;

use ArrayAccess;
use JsonSerializable;
use Stringable as BaseStringable;

/**
 * Laravel 13 has `counted()` (13.19.0) and the `$normalize` parameter of `pascal()` and `studly()` (13.12.0). Only
 * these methods are declared: the rest merges from `common`.
 *
 * @psalm-taint-specialize
 */
class Stringable implements JsonSerializable, ArrayAccess, BaseStringable
{
    /**
     * @param  int|array|\Countable  $count
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function counted($count) {}

    /**
     * @param  bool  $normalize
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function pascal(bool $normalize = false) {}

    /**
     * @param  bool  $normalize
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function studly(bool $normalize = false) {}
}
