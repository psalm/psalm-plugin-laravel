<?php

namespace Illuminate\Database\Schema;

/**
 * Builder::getColumn() exists from Laravel 13.34. It returns a full `getColumns()` row or `[]` for an
 * absent column, but documents only the full shape, which makes `getColumn(...) === []` a
 * DocblockTypeContradiction. Psalm merges `array{...}|array{}` into ONE shape with every key optional,
 * so the union would report PossiblyUndefinedArrayOffset on the guarded `$column['name']` access (a
 * false positive); a bare `array` (the facade tag's type) avoids both.
 *
 * The class header is copied verbatim because re-declaring the class resets Psalm's implements list
 * (hard rule 2). Methods not restated here (and their taint sinks) survive from the common stub.
 */
class Builder
{
    /**
     * @param  string  $table
     * @param  string  $column
     * @return array
     */
    public function getColumn($table, $column) {}
}
