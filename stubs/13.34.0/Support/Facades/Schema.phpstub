<?php

namespace Illuminate\Support\Facades;

/**
 * Schema\Builder::getColumn() exists from Laravel 13.34 and returns `[]` for an absent column while its
 * `@return` documents only the full column shape, so resolving it via the common stub's
 * `@mixin Schema\Builder` would make `getColumn(...) === []` a DocblockTypeContradiction. The method is
 * restated with the facade's own `@method` tag signature, which FacadeStubPrecedenceHandler then prefers
 * over the pseudo-method. The class header is copied verbatim (hard rule 2); other methods and the
 * common stub's `@mixin` survive the re-declaration.
 */
class Schema extends Facade
{
    /**
     * @param  string  $table
     * @param  string  $column
     * @return array
     */
    public static function getColumn($table, $column) {}
}
