<?php

namespace Illuminate\Support;

use ArrayAccess;
use JsonSerializable;
use Stringable as BaseStringable;

/**
 * Laravel 12.51.0 lets `deduplicate()` take several characters. Only these methods are declared: the rest merges
 * from `common`.
 *
 * @psalm-taint-specialize
 */
class Stringable implements JsonSerializable, ArrayAccess, BaseStringable
{
    /**
     * @param  array<string>|string  $characters
     * @return static
     * @psalm-flow ($this) -> return
     */
    public function deduplicate(array|string $characters = ' ') {}
}
