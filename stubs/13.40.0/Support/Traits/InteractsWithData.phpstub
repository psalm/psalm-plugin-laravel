<?php

namespace Illuminate\Support\Traits;

/**
 * Laravel 13.40 added `$strict` to the scalar casts (laravel/framework#62254). Every annotation of the common
 * stub's declaration is restated (hard rule 4); the trait's other methods fall through to common.
 */
trait InteractsWithData
{
    /**
     * @param  string  $key
     * @param  mixed  $default
     * @param  bool  $strict
     * @return \Illuminate\Support\Stringable
     *
     * @psalm-taint-source input
     */
    public function str($key, $default = null, $strict = false) {}

    /**
     * @param  string  $key
     * @param  mixed  $default
     * @param  bool  $strict
     * @return \Illuminate\Support\Stringable
     *
     * @psalm-taint-source input
     */
    public function string($key, $default = null, $strict = false) {}

    /**
     * Not a taint source: (int) cast cannot produce an injection payload.
     *
     * @param  string  $key
     * @param  int  $default
     * @param  bool  $strict
     * @return int
     */
    public function integer($key, $default = 0, $strict = false) {}

    /**
     * Not a taint source: (float) cast cannot produce an injection payload.
     *
     * @param  string  $key
     * @param  float  $default
     * @param  bool  $strict
     * @return float
     */
    public function float($key, $default = 0.0, $strict = false) {}

    /**
     * Not a taint source: a boolean cannot carry injectable content.
     *
     * @param  string|null  $key
     * @param  bool  $default
     * @param  bool  $strict
     * @return bool
     */
    public function boolean($key = null, $default = false, $strict = false) {}
}
