<?php

namespace Illuminate\Support;

use Illuminate\Contracts\Support\ValidatedData;

/**
 * Laravel 13.40 added `$strict` to the scalar casts (laravel/framework#62254). The class header is copied
 * verbatim (hard rule 2); the common stub's other methods survive.
 *
 * @template TRequest of \Illuminate\Foundation\Http\FormRequest
 */
class ValidatedInput implements ValidatedData
{
    /**
     * @param  string  $key
     * @param  mixed  $default
     * @param  bool  $strict
     * @return \Illuminate\Support\Stringable
     *
     * @psalm-taint-source input
     */
    public function str($key, $default = null, $strict = false) {}

    /**
     * @param  string  $key
     * @param  mixed  $default
     * @param  bool  $strict
     * @return \Illuminate\Support\Stringable
     *
     * @psalm-taint-source input
     */
    public function string($key, $default = null, $strict = false) {}

    /**
     * @param  string  $key
     * @param  int  $default
     * @param  bool  $strict
     * @return int
     */
    public function integer($key, $default = 0, $strict = false) {}

    /**
     * @param  string  $key
     * @param  float  $default
     * @param  bool  $strict
     * @return float
     */
    public function float($key, $default = 0.0, $strict = false) {}

    /**
     * @param  string|null  $key
     * @param  bool  $default
     * @param  bool  $strict
     * @return bool
     */
    public function boolean($key = null, $default = false, $strict = false) {}
}
