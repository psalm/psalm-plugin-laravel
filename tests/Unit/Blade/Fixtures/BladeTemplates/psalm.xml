<?xml version="1.0"?>
<psalm
    errorLevel="1"
    sealAllProperties="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
>
    <projectFiles>
        <directory name="app" />
    </projectFiles>
    <plugins>
        <plugin filename="plugins/ProvidedPropertyPlugin.php" />
        <pluginClass class="Psalm\LaravelPlugin\Plugin">
            <blade cacheDir=".cache/blade-shadows" />
        </pluginClass>
    </plugins>
    <issueHandlers>
        <!-- Psalm 7 suggests purity tags on the type-only fixture classes; they are not what these tests pin. -->
        <MissingPureAnnotation errorLevel="info" />
        <MissingImmutableAnnotation errorLevel="info" />
        <PluginIssue name="BladeCompileError">
            <errorLevel type="suppress">
                <file name="resources/views/broken-suppressed.blade.php" />
            </errorLevel>
        </PluginIssue>
    </issueHandlers>
</psalm>
