<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    cacheDirectory=".cache/psalm-cached"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
>
    <projectFiles>
        <directory name="app" />
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\LaravelPlugin\Plugin">
            <blade cacheDir=".cache/blade-shadows-cached" />
        </pluginClass>
    </plugins>
    <issueHandlers>
        <!-- Illuminate\View\Component declares uninitialised properties; the fixture classes are not what these tests pin. -->
        <MissingConstructor errorLevel="suppress" />
        <!-- The fixture classes are type-only shapes; purity suggestions are not what these tests pin. -->
        <MissingPureAnnotation errorLevel="suppress" />
        <MissingImmutableAnnotation errorLevel="suppress" />
    </issueHandlers>
</psalm>
