<?xml version="1.0"?>
<psalm
    errorLevel="1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
>
    <projectFiles>
        <directory name="cases" />
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\LaravelPlugin\Plugin">
            <findOctaneIncompatibleBinding value="true" />
            <!-- A Blade finding is reported on the template and never rewritten: see PsalterFixTest. -->
            <blade cacheDir=".cache/blade-shadows" />
        </pluginClass>
    </plugins>
</psalm>
